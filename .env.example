# Stringa di connessione MongoDB Atlas (cluster gratuito M0)
# Atlas > Database > Connect > Drivers
MONGODB_URI="mongodb+srv://utente:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"

# Nome del database (opzionale, default: cashflow)
MONGODB_DB="cashflow"

# Segreto usato da Vercel Cron per autorizzare /api/cleanup (opzionale ma consigliato)
CRON_SECRET="cambia-questa-stringa"
