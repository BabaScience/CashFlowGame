# ── MongoDB Atlas ───────────────────────────────────────────────────────────
# Copia questo file in .env e riempilo con i tuoi dati.
# Le stesse tre variabili vanno impostate su Vercel, in
# Project Settings > Environment Variables.

# Indirizzo del cluster. Su Atlas: Connect > Drivers > Node.js.
# Puoi lasciare i segnaposto <db_username> e <db_password> come sono:
# vengono sostituiti in automatico con le due variabili qui sotto.
MONGODB_URI="mongodb+srv://<db_username>:<db_password>@cluster0.ab1cd.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0"

# Utente del database (Atlas > Database Access).
# Attenzione: non è l'account con cui entri nel sito di Atlas.
MONGODB_USERNAME="utente-del-database"

# Password di quell'utente. Può contenere @ / : # % senza problemi:
# viene codificata automaticamente.
MONGODB_PASSWORD="la-tua-password"

# Nome del database (facoltativo, predefinito: cashflow)
MONGODB_DB="cashflow"

# ── Pulizia automatica ──────────────────────────────────────────────────────
# Stringa a caso: protegge /api/cleanup, che Vercel richiama una volta al
# giorno per liberare lo spazio delle stanze scadute.
CRON_SECRET="cambia-questa-stringa"

# ── Anteprima dei collegamenti (facoltativo) ────────────────────────────────
# Indirizzo pubblico del sito, usato per l'immagine che appare quando
# condividi il link. Su Vercel viene ricavato da solo: serve solo se usi
# un dominio tuo.
# VITE_SITE_URL="https://cashflow.tuodominio.it"

# ── Metriche (facoltativo) ─────────────────────────────────────────────
# Serve solo a RILEGGERE i contatori d'uso da GET /api/eventi.
# La scrittura funziona senza. I contatori non contengono dati personali:
# nessun identificativo lascia mai il dispositivo, vedi src/lib/traccia.js.
# Scegli una stringa lunga a caso.
METRICHE_TOKEN=
